<script>
  const rabbit = document.querySelector<HTMLElement>('.rabbit')!;
  const grid = rabbit.parentElement!;
  const konijn = grid.querySelector<HTMLElement>('.konijn')!;
  const planria = grid.querySelector<HTMLElement>('.planria')!;
  const writing = grid.querySelector<HTMLElement>('.writing')!;
  const planriaScene = rabbit.querySelector<HTMLElement>('[data-rabbit-scene="planria"]')!;
  const writingScene = rabbit.querySelector<HTMLElement>('[data-rabbit-scene="writing"]')!;
  const konijnScene = rabbit.querySelector<HTMLElement>('[data-rabbit-scene="konijn"]')!;
  const desktop = matchMedia('(min-width: 1001px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let start = 0;
  let end = 1;
  let progress = 0;
  let target = 0;
  let frame = 0;

  function phase(value: number, from: number, to: number) {
    return Math.max(0, Math.min(1, (value - from) / (to - from)));
  }

  function draw() {
    frame = 0;
    progress += (target - progress) * 0.14;
    const moving = Math.abs(target - progress) > 0.0001;
    if (!moving) progress = target;
    rabbit.style.setProperty("--rabbit-progress", String(progress));
    planriaScene.style.setProperty("--scene-progress", String(phase(progress, 0, .28)));
    writingScene.style.setProperty("--scene-progress", String(phase(progress, .2, .76)));
    konijnScene.style.setProperty("--scene-progress", String(phase(progress, .68, 1)));
    if (moving) frame = requestAnimationFrame(draw);
  }

  function update() {
    if (!desktop.matches) return;
    const next = reduced.matches ? 1 : Math.max(0, Math.min(1, (scrollY - start) / (end - start)));
    if (next === target && frame) return;
    target = next;
    if (reduced.matches) progress = target;
    if (!frame) frame = requestAnimationFrame(draw);
  }

  function measure() {
    const gridBounds = grid.getBoundingClientRect();
    const place = (scene: HTMLElement, tile: HTMLElement) => {
      const bounds = tile.getBoundingClientRect();
      scene.style.left = `${bounds.left - gridBounds.left}px`;
      scene.style.top = `${bounds.top - gridBounds.top}px`;
      scene.style.width = `${bounds.width}px`;
      scene.style.height = `${bounds.height}px`;
    };
    place(planriaScene, planria);
    place(writingScene, writing);
    place(konijnScene, konijn);
    konijnScene.style.setProperty("--scene-width", `${konijn.offsetWidth}px`);
    writingScene.style.setProperty("--scene-width", `${writing.offsetWidth}px`);
    start = planria.getBoundingClientRect().top + scrollY - innerHeight * 0.75;
    end = Math.max(start + 1, Math.min(konijn.getBoundingClientRect().top + scrollY - innerHeight * 0.65, document.documentElement.scrollHeight - innerHeight));
    rabbit.style.visibility = 'visible';
    update();
  }

  new ResizeObserver(measure).observe(grid);
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', measure);
  desktop.addEventListener('change', measure);
  reduced.addEventListener('change', update);
</script>

<style>
  .rabbit { --rabbit-ink:#17120f;--rabbit-orange:#f45b12;position:absolute;inset:0;pointer-events:none;visibility:hidden; }
  .rabbit-scene { --scene-progress:0;position:absolute;z-index:0;overflow:visible; }
  [data-rabbit-scene="konijn"] { z-index:2; }
  .rabbit svg { position:absolute;overflow:visible;will-change:transform,opacity;animation-duration:1s;animation-timing-function:linear;animation-fill-mode:both;animation-play-state:paused;animation-delay:calc(var(--scene-progress) * -1s); }
  .ink { fill:var(--rabbit-ink); }
  .orange { fill:var(--rabbit-orange); }

  .planria-peek { width:100px;left:38%;top:-38px;animation-name:planria-rise; }
  .planria-ear-left { transform-origin:57px 66px;animation:planria-listen 1.8s ease-in-out infinite; }
  .planria-ear-right { transform-origin:70px 67px;animation:planria-listen 1.8s .14s ease-in-out infinite reverse; }
  .planria-eye,.scout-eye,.vault-eye { animation:blink 4.7s linear infinite;transform-box:fill-box;transform-origin:center; }
  .planria-paws { animation:paw-grip 700ms ease-in-out infinite alternate; }

  .writing-tail { width:86px;left:-42px;top:44%;animation-name:tail-burrow; }
  .writing-hind-paw { transform-origin:52px 72px;animation:kick-dirt 320ms ease-in-out infinite alternate; }
  .writing-scout { width:130px;left:0;top:-40px;animation-name:scout-run; }
  .scout-ear-left { transform-origin:49px 52px;animation:scout-ear 340ms ease-in-out infinite alternate; }
  .scout-ear-right { transform-origin:64px 53px;animation:scout-ear 340ms -120ms ease-in-out infinite alternate-reverse; }
  .scout-whiskers,.vault-whiskers { transform-origin:center;animation:whisker 220ms ease-in-out infinite alternate; }

  .konijn-vault { width:160px;left:0;top:-162px;animation-name:konijn-vault; }
  .vault-ear-back,.vault-ear-front { transform-box:fill-box;transform-origin:bottom;animation:vault-ears 6s ease-in-out infinite; }
  .vault-ear-front { animation-delay:-110ms; }
  .vault-shadow { animation:shadow-pulse 360ms ease-in-out infinite alternate;transform-origin:center; }

  @keyframes planria-rise {
    0%,8%{transform:translateY(76px) rotate(-4deg);opacity:0}
    20%{transform:translateY(24px) rotate(2deg);opacity:1}
    48%{transform:translateY(17px) rotate(-2deg);opacity:1}
    70%{transform:translate(32px,25px) rotate(4deg);opacity:1}
    100%{transform:translate(54px,78px) rotate(9deg);opacity:0}
  }
  @keyframes tail-burrow {
    0%,5%{transform:translateX(48px) rotate(-8deg);opacity:0}
    18%{transform:translateX(0) rotate(8deg);opacity:1}
    40%{transform:translateX(-8px) rotate(-5deg);opacity:1}
    56%,100%{transform:translateX(58px) rotate(14deg);opacity:0}
  }
  @keyframes scout-run {
    0%,24%{transform:translate(-115px,30px) rotate(-8deg);opacity:0}
    32%{opacity:1}
    46%{transform:translate(calc(var(--scene-width) * .26),0) rotate(2deg);opacity:1}
    62%{transform:translate(calc(var(--scene-width) * .62),4px) rotate(-2deg);opacity:1}
    76%{transform:translate(calc(var(--scene-width) - 72px),38px) rotate(8deg);opacity:1}
    84%,100%{transform:translate(calc(var(--scene-width) - 46px),76px) rotate(12deg);opacity:0}
  }
  @keyframes konijn-vault {
    0%,8%{transform:translate(-125px,94px) scale(.86) rotate(-10deg);opacity:0}
    18%{opacity:1}
    36%{transform:translate(calc(var(--scene-width) * .18),-12px) scale(1.02) rotate(4deg);opacity:1}
    58%{transform:translate(calc(var(--scene-width) * .48),-22px) scale(1) rotate(-2deg);opacity:1}
    78%{transform:translate(calc(var(--scene-width) * .68),-5px) scale(.96) rotate(5deg);opacity:1}
    100%{transform:translate(calc(var(--scene-width) * .68),8px) scale(.94) rotate(0);opacity:1}
  }
  @keyframes planria-listen { 0%,100%{transform:rotate(0)}45%{transform:rotate(-8deg)}65%{transform:rotate(5deg)} }
  @keyframes paw-grip { from{transform:translateY(0)}to{transform:translateY(-3px)} }
  @keyframes kick-dirt { from{transform:rotate(-8deg)}to{transform:rotate(17deg) translateX(3px)} }
  @keyframes scout-ear { from{transform:rotate(-12deg)}to{transform:rotate(9deg)} }
  @keyframes whisker { from{transform:rotate(-1deg)}to{transform:rotate(3deg)} }
  @keyframes vault-tail { from{transform:scale(.94) rotate(-5deg)}to{transform:scale(1.08) rotate(8deg)} }
  @keyframes vault-ears { 0%,80%,100%{transform:rotate(0)}86%{transform:rotate(-7deg)}92%{transform:rotate(3deg)} }
  @keyframes vault-kick { from{transform:rotate(-18deg)}to{transform:rotate(22deg) translateX(4px)} }
  @keyframes vault-reach { from{transform:rotate(-12deg)}to{transform:rotate(24deg)} }
  @keyframes shadow-pulse { from{transform:scaleX(.55);opacity:.08}to{transform:scaleX(1);opacity:.17} }
  @keyframes blink { 0%,43%,47%,100%{transform:scaleY(1)}45%{transform:scaleY(.08)} }
  @media(prefers-reduced-motion:reduce) {
    .rabbit * { animation:none!important; }
    .rabbit svg { opacity:0 }
    .rabbit .konijn-vault { opacity:1;transform:translate(calc(var(--scene-width) * .68),8px) scale(.94) rotate(0) }
  }
  @media(max-width:1000px) { .rabbit { display:none; } }
</style>
