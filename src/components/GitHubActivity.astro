---
import activity from '@/lib/data/github-contributions.json';
import { GITHUB_URL } from '@/lib/constants';
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const updated = dateFormat.format(new Date(activity.fetchedAt));
---
<section class="github-activity" data-github-activity aria-labelledby="github-title">
  <div class="activity-head"><h2 id="github-title">Always <em>building.</em></h2><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">@mrlemoos ↗</a></div>
  <div class="activity-summary"><strong data-activity-total>{activity.total.toLocaleString('en-GB')} contributions</strong><span>Past year on GitHub</span></div>
  <p class="sr-only" id="activity-help">Use arrow keys to explore daily contribution counts. Tap a square to show its count.</p>
  <div class="calendar-scroll">
    <div class="calendar" data-calendar style={`--weeks:${Math.ceil(activity.days.length / 7)}`} role="group" aria-label="Daily GitHub contributions" aria-describedby="activity-help">
      {activity.days.map((day, i) => <button type="button" class={`day level-${day.level}`} tabindex={i === 0 ? 0 : -1} data-label={`${dateFormat.format(new Date(day.date))}: ${day.count} ${day.count === 1 ? 'contribution' : 'contributions'}`} aria-label={`${dateFormat.format(new Date(day.date))}: ${day.count} ${day.count === 1 ? 'contribution' : 'contributions'}`}></button>)}
    </div>
  </div>
  <div class="activity-foot"><span data-activity-updated>Updated {updated}</span><div aria-label="Activity legend: less to more"><span>Less</span>{[0,1,2,3,4].map(level => <i class={`day level-${level}`}></i>)}<span>More</span></div></div>
  <div class="activity-tooltip" id="activity-tooltip" data-activity-tooltip role="tooltip" hidden></div>
</section>
<script>
  import type { GitHubActivity } from '@/lib/github-contributions';
  const root = document.querySelector<HTMLElement>('[data-github-activity]');
  if (root) {
    const calendar = root.querySelector<HTMLElement>('[data-calendar]')!;
    const tooltip = root.querySelector<HTMLElement>('[data-activity-tooltip]')!;
    let active: HTMLButtonElement | null = null;
    const hide = () => { tooltip.hidden = true; active?.removeAttribute('aria-describedby'); active = null; };
    const show = (button: HTMLButtonElement) => {
      active?.removeAttribute('aria-describedby');
      active = button;
      tooltip.textContent = button.dataset.label ?? '';
      tooltip.hidden = false;
      button.setAttribute('aria-describedby', tooltip.id);
      const rect = button.getBoundingClientRect();
      const size = tooltip.getBoundingClientRect();
      tooltip.style.left = `${Math.max(8, Math.min(window.innerWidth - size.width - 8, rect.left + rect.width / 2 - size.width / 2))}px`;
      tooltip.style.top = `${rect.top > size.height + 12 ? rect.top - size.height - 10 : rect.bottom + 10}px`;
    };
    calendar.addEventListener('pointerover', event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button'); if (button) show(button); });
    calendar.addEventListener('pointerleave', hide);
    calendar.addEventListener('focusin', event => show(event.target as HTMLButtonElement));
    calendar.addEventListener('focusout', hide);
    calendar.addEventListener('click', event => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button'); if (button) show(button); });
    calendar.addEventListener('keydown', event => {
      if (event.key === 'Escape') { hide(); return; }
      const buttons = [...calendar.querySelectorAll<HTMLButtonElement>('button')];
      const index = buttons.indexOf(event.target as HTMLButtonElement);
      const moves: Record<string, number> = { ArrowLeft: -7, ArrowRight: 7, ArrowUp: -1, ArrowDown: 1 };
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : event.key in moves ? index + moves[event.key] : undefined;
      if (next === undefined) return;
      event.preventDefault();
      const target = buttons[Math.max(0, Math.min(buttons.length - 1, next))];
      buttons.forEach(button => { button.tabIndex = button === target ? 0 : -1; });
      target.focus();
    });
    window.addEventListener('scroll', hide, true);
    window.addEventListener('resize', hide);
    fetch('/api/github').then(async response => {
      if (!response.ok) throw new Error('Activity unavailable');
      const data: GitHubActivity = await response.json();
      if (!Array.isArray(data.days) || data.days.length < 350 || !Number.isSafeInteger(data.total)) return;
      const formatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
      const fragment = document.createDocumentFragment();
      data.days.forEach((day, i) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `day level-${day.level}`;
        button.tabIndex = i === 0 ? 0 : -1;
        button.dataset.label = `${formatter.format(new Date(day.date))}: ${day.count} ${day.count === 1 ? 'contribution' : 'contributions'}`;
        button.setAttribute('aria-label', button.dataset.label);
        fragment.append(button);
      });
      // Leave keyboard focus in place if someone is already exploring the chart.
      if (!calendar.contains(document.activeElement)) { hide(); calendar.replaceChildren(fragment); calendar.style.setProperty('--weeks', String(Math.ceil(data.days.length / 7))); }
      root.querySelector('[data-activity-total]')!.textContent = `${data.total.toLocaleString('en-GB')} contributions`;
      root.querySelector('[data-activity-updated]')!.textContent = `Updated ${formatter.format(new Date(data.fetchedAt))}`;
    }).catch(() => { /* Keep the last verified contribution calendar visible. */ });
  }
</script>
<style>
.github-activity{color:#2e4538;width:100%}.activity-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:30px}.activity-head h2{font-size:32px;line-height:1.1;letter-spacing:-.06em;font-weight:400}.activity-head em{font-family:var(--font-instrument-serif);font-weight:400}.activity-head a{font-size:10px;white-space:nowrap;color:#607c68}.activity-head a:hover{text-decoration:underline;text-underline-offset:5px}.activity-summary{display:flex;justify-content:space-between;gap:15px;margin-bottom:15px;font-size:10px}.activity-summary strong{font-weight:500}.activity-summary>span{color:#718277}.calendar-scroll{overflow-x:auto;padding:3px 0 9px}.calendar{display:grid;grid-template-rows:repeat(7,1fr);grid-template-columns:repeat(var(--weeks),1fr);grid-auto-flow:column;gap:4px;min-width:550px}.github-activity :global(.day){display:block;aspect-ratio:1;border-radius:2px;background:#e3eae3;border:0;padding:0;min-width:0}.calendar :global(.day){cursor:pointer;transition:box-shadow .15s,filter .15s}.calendar :global(.day):hover,.calendar :global(.day):focus-visible{filter:brightness(1.13);box-shadow:0 0 0 2px #486a5580;outline:none;z-index:1}.github-activity :global(.level-1){background:#c3d7bd}.github-activity :global(.level-2){background:#90b78b}.github-activity :global(.level-3){background:#5c9369}.github-activity :global(.level-4){background:#2e6b49}.activity-foot{display:flex;justify-content:space-between;gap:20px;margin-top:10px;font-size:9px;color:#718277}.activity-foot>div{display:flex;align-items:center;gap:4px}.activity-foot :global(.day){width:9px}.activity-foot span:first-child{margin-right:4px}.activity-foot span:last-child{margin-left:4px}.activity-tooltip{position:fixed;z-index:100;background:#233d2d;color:#fff;padding:10px 13px;border-radius:9px;font-size:11px;white-space:nowrap;pointer-events:none;box-shadow:0 6px 20px #122f2328}.activity-tooltip[hidden]{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(prefers-color-scheme:dark){.github-activity{color:#dde9df}.activity-head a,.activity-summary>span,.activity-foot{color:#a4b8a9}.github-activity :global(.day){background:#2b3c31}.github-activity :global(.level-1){background:#3e624b}.github-activity :global(.level-2){background:#628c69}.github-activity :global(.level-3){background:#8eb48e}.github-activity :global(.level-4){background:#bed7b2}.activity-tooltip{background:#d9e9da;color:#22372a}}@media(max-width:700px){.activity-head{gap:12px;margin-bottom:24px}.activity-head h2{font-size:29px}.activity-head a{font-size:9px}.activity-summary{font-size:9px}.calendar{min-width:490px;gap:3px}.activity-foot{font-size:8px}}@media(prefers-reduced-motion:reduce){.calendar :global(.day){transition:none}}
</style>
