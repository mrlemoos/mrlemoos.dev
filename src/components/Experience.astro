---
import { experiences } from "@/lib/data/experience";
import { cn, sectionTitle, textLink } from "@/lib/css";
---

<section class="section-fade-top my-24 pt-20 md:pt-24">
  <h2 class={cn(sectionTitle, "mb-10")}>Experience</h2>
  {/* Hairlines, not panels — the same treatment the writing list uses. */}
  <div class="flex flex-col">
    {
      experiences.map(
        ({ company, companyURL, title, period, description, skills }, index) => (
          <article
            class="reveal border-t border-border py-7 first:border-t-0 first:pt-0 md:py-8 md:first:pt-0"
            style={`--reveal-index: ${Math.min(index, 6)}`}
          >
            <div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="font-heading text-xl font-normal leading-[1.15] tracking-[-0.02em] text-foreground">
                {title}
              </h3>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.18em] tabular-nums text-muted-foreground">
                {period}
              </span>
            </div>
            <a
              href={companyURL}
              target="_blank"
              rel="noopener noreferrer"
              class={textLink}
            >
              {company}
            </a>
            {description.length > 0 && (
              <ul class="mb-3 mt-3 list-inside list-disc space-y-1.5 leading-[1.6] text-muted-foreground">
                {description.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
            <p class="text-sm leading-[1.6] tracking-[0.01em] text-muted-foreground">
              {skills.join(", ")}
            </p>
          </article>
        )
      )
    }
  </div>
</section>
