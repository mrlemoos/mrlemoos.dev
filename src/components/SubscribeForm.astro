---
import { cn, materialThin, sectionEyebrow } from "@/lib/css";

interface Props {
  heading?: string;
  blurb?: string;
  eyebrow?: string;
  class?: string;
}

const {
  heading = "New posts, in your inbox",
  blurb = "Occasional writing on software, craft, and whatever I'm chewing on. No spam, unsubscribe in one click.",
  eyebrow = "Newsletter",
  class: className,
} = Astro.props;
---

<section class={cn("flex flex-col gap-4", className)} data-subscribe data-state="idle">
  <div class="flex flex-col gap-2">
    <span class={sectionEyebrow}>{eyebrow}</span>
    <span class="font-heading text-xl leading-[1.15] tracking-[-0.02em] text-foreground md:text-2xl">
      {heading}
    </span>
    <p class="max-w-prose text-pretty text-sm leading-relaxed text-muted-foreground">
      {blurb}
    </p>
  </div>

  <form
    method="post"
    action="/api/subscribe"
    class="flex w-full flex-col gap-2 sm:flex-row"
    novalidate
  >
    <div class="subscribe-field relative flex-1">
      <!-- aria-label, not <label for>: several instances can share a page (footer + in-body). -->
      <input
        aria-label="Email address"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class={cn(
          materialThin,
          "subscribe-input min-h-12 w-full rounded-full px-5 text-sm text-foreground placeholder:text-muted-foreground/70",
          "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        )}
      />
    </div>
    <!-- Honeypot: hidden from people, catnip for bots. -->
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="pointer-events-none absolute h-0 w-0 opacity-0"
    />
    <button
      type="submit"
      class={cn(
        materialThin,
        "subscribe-button min-h-12 shrink-0 cursor-pointer rounded-full px-7 text-sm font-medium text-foreground",
        "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
        "disabled:cursor-not-allowed disabled:opacity-60"
      )}
    >
      <!-- One slot, three cues: the label stays for the accessible name. -->
      <span class="subscribe-slot">
        <span data-cue="label">Subscribe</span>
        <span data-cue="loading" aria-hidden="true">
          <svg
            class="subscribe-spinner"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
          >
            <circle cx="8" cy="8" r="6.5" opacity="0.25"></circle>
            <path d="M14.5 8A6.5 6.5 0 0 0 8 1.5" stroke-linecap="round"></path>
          </svg>
        </span>
        <span data-cue="success" aria-hidden="true">
          <svg
            class="subscribe-tick"
            width="16"
            height="16"
            viewBox="0 0 13 11"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M1 5.5 L4.2 9 L11 1.5"></path>
          </svg>
        </span>
      </span>
    </button>
  </form>

  <p
    class="subscribe-status min-h-5 text-sm text-muted-foreground"
    role="status"
    aria-live="polite"
    data-subscribe-status
  >
  </p>
</section>

<script>
  import { SUBSCRIBE_MESSAGES, subscribeOutcome } from "@/lib/subscribe-messages";

  document.querySelectorAll<HTMLElement>("[data-subscribe]").forEach((root) => {
    const form = root.querySelector("form");
    const status = root.querySelector<HTMLElement>("[data-subscribe-status]");
    if (!form || !status) return;

    const email = form.querySelector<HTMLInputElement>("input[name=email]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const field = form.querySelector<HTMLElement>(".subscribe-field");

    // `.is-shaking` is orthogonal to the error state so a second rejection in
    // a row replays the shake without flickering the border back to neutral.
    field?.addEventListener("animationend", () =>
      field.classList.remove("is-shaking")
    );

    /** Announces the state, and replays the message animation from the top. */
    const announce = (
      state: "idle" | "loading" | "success" | "error",
      message: string,
      tone: "muted" | "positive" | "negative"
    ) => {
      root.dataset.state = state;
      status.dataset.tone = tone;
      status.classList.remove("is-entering");
      void status.offsetWidth; // Reflow, so the same message can animate again.
      status.textContent = message;
      status.classList.add("is-entering");

      if (state === "error" && field) {
        field.classList.remove("is-shaking");
        void field.offsetWidth; // Same reflow, or the shake never restarts.
        field.classList.add("is-shaking");
      }
    };

    // Typing after a result puts the form back to rest.
    email?.addEventListener("input", () => {
      if (root.dataset.state === "idle" || root.dataset.state === "loading") return;
      root.dataset.state = "idle";
      status.dataset.tone = "muted";
      status.textContent = "";
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (root.dataset.state === "loading") return;

      const data = Object.fromEntries(new FormData(form));

      if (button) button.disabled = true;
      form.setAttribute("aria-busy", "true");
      announce("loading", SUBSCRIBE_MESSAGES.loading, "muted");

      let outcome;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const body = await response.json().catch(() => ({}));
        outcome = subscribeOutcome({ ok: response.ok, error: body.error });
      } catch {
        outcome = subscribeOutcome({ ok: false, network: true });
      }

      if (outcome.state === "success") form.reset();
      announce(
        outcome.state,
        outcome.message,
        outcome.state === "success" ? "positive" : "negative"
      );

      form.removeAttribute("aria-busy");
      if (button) button.disabled = false;
    });
  });
</script>
