---
import WritingList from "@/components/WritingList.astro";
import { cn, sectionEyebrow, textLink } from "@/lib/css";
import { getFeaturedWriting } from "@/lib/writing";

const entries = await getFeaturedWriting(4);

const items = entries.map((entry) => ({
  href: entry.href,
  title: entry.title,
  date: entry.date,
  external: entry.kind === "external",
  publisher: entry.publisher,
}));
---

<div class="mt-12 w-full text-left md:mt-14">
  <div
    class="reveal mb-1 flex items-end justify-between gap-4"
    style="--reveal-index: 2"
  >
    <p class={sectionEyebrow}>Featured writing</p>
    <a href="/blog" class={cn(textLink, "shrink-0 text-xs font-medium tracking-[0.04em]")}>
      All posts →
    </a>
  </div>

  <WritingList items={items} numbered startIndex={2} />
</div>
