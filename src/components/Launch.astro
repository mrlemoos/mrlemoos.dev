---
import { EMAIL_URL, GITHUB_URL, LINKEDIN_URL } from '@/lib/constants';
import { projects, projectStatusLabel } from '@/lib/data/projects';
import { getFeaturedWriting } from '@/lib/writing';
import GitHubActivity from './GitHubActivity.astro';
import GrabkitPreview from './GrabkitPreview.astro';
import KonijnRabbit from './KonijnRabbit.astro';
import LudusBoard from './LudusBoard';
const writing = await getFeaturedWriting(3);
const madrid = projects.find(project => project.name === 'Madrid')!;
const termi = projects.find(project => project.name === 'Termi')!;
const grabkit = projects.find(project => project.name === 'Grabkit')!;
const planria = projects.find(project => project.name === 'plan/ria')!;
const instagram = 'https://www.instagram.com/don.leo.lemos/';
---
<div class="launch">
  <a class="skip" href="#work">Skip to content</a>
  <header class="launch-nav">
    <a class="wordmark" href="/" aria-label="Leonardo Lemos home">leo<span>.</span></a>
    <nav aria-label="Main navigation"><a href="/projects">Work</a><a href="/blog">Writing</a><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    <a class="nav-contact" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
  </header>
  <div class="bento" id="work">
    <KonijnRabbit />
    <section class="tile bio" aria-labelledby="name">
      <div class="tile-label"><span>Frontend engineer</span><span class="tiny-mark" aria-hidden="true">↗</span></div>
      <h1 id="name">Leonardo<br/><em>Lemos.</em></h1>
      <p>I build interfaces with care.<br/>And the systems behind them.</p>
      <a class="text-link" href={`${EMAIL_URL}?subject=Let's%20build%20something`}>Build something with me <span aria-hidden="true">↗</span></a>
      <div class="bio-footer"><span>Currently at <a href="https://credo.ai" target="_blank" rel="noopener noreferrer">Credo AI</a></span><span>Previously AB InBev</span></div>
    </section>
    <section class="tile location" aria-label="Based in Madrid, Spain">
      <div class="location-art" aria-hidden="true">
        <span class="location-coordinate">40°25′ N / 3°42′ W</span>
        <div class="gran-via-shadow"></div>
        <img class="gran-via" src="/images/gran-via.webp" alt="" width="800" height="691" fetchpriority="high" />
      </div>
      <div class="location-copy"><h2>Madrid<span>ES</span></h2><p>Where I call home.</p></div>
    </section>
    <a class="tile photo photo-street" href={instagram} target="_blank" rel="noopener noreferrer" aria-label="View Leonardo's Madrid street photograph on Instagram">
      <img src="/images/photography/madrid-light.jpg" alt="Cobblestone street between pastel façades on Calle de Afonso VI, Madrid" width="1200" height="800" fetchpriority="high"/>
      <span class="photo-credit">Through my lens <span aria-hidden="true">↗</span></span>
    </a>
    <section class="tile impact" aria-label="Performance improvement at AB InBev"><p class="tile-label">AB InBev · Web performance</p><strong>8× <small>faster</small></strong><p>Cut time to first visible content<br/>from 6.4 seconds to 0.8 seconds.</p></section>
    <a class="tile madrid product" href={madrid.url} target="_blank" rel="noopener noreferrer">
      <div class="tile-label"><span>Native Mac notes</span><span aria-hidden="true">↗</span></div>
      <h2>Madrid</h2><p>A little room to think.</p>
      <div class="madrid-screen"><img src="/images/madrid-app.png" alt="Madrid Mac app with a note open in its writing editor" width="1600" height="1000" loading="lazy" /></div>
      <div class="product-footer"><span>Linked ideas. Local-first. Cloud sync.</span><span>{projectStatusLabel[madrid.status]}</span></div>
    </a>
    <a class="tile termi product" href={termi.url} target="_blank" rel="noopener noreferrer">
      <div class="tile-label"><span>A terminal for coding agents</span><span aria-hidden="true">↗</span></div>
      <h2>Termi</h2><p>Your next idea starts here.</p>
      <div class="terminal-scene" aria-hidden="true">
        <div class="terminal-window">
          <div class="terminal-lights"><i></i><i></i><i></i></div>
          <div class="terminal-body">
            <div class="terminal-prompt"><span>leo</span><span>~/Developer/Termi</span><b>❯</b> claude</div>
            <div class="terminal-agent"><pre>{" ▐▛███▜▌ \n▝▜█████▛▘\n  ▘▘ ▝▝  "}</pre><div><strong>Claude Code</strong><span>~/Developer/Termi</span></div></div>
            <div class="terminal-request"><span>❯</span> Build something worth shipping.<i></i></div>
            <div class="terminal-thinking">✻ Thinking… <span>esc to interrupt</span></div>
          </div>
          <div class="terminal-tabs"><span class="terminal-tab-active">⌘1 claude <pre>{" ▐▛███▜▌ \n▝▜█████▛▘\n  ▘▘ ▝▝  "}</pre></span><span>⌘2 codex</span><span>⌘3 zsh</span><span class="terminal-cwd">~/Termi</span></div>
        </div>
      </div>
      <div class="product-footer"><span>macOS · Open source</span><span>{projectStatusLabel[termi.status]}</span></div>
    </a>
    <div class="tile github"><GitHubActivity /></div>
    <section class="tile contact" id="contact" aria-labelledby="contact-title"><p class="tile-label">The next good thing</p><h2 id="contact-title">Starts with<br/><em>a hello.</em></h2><a class="contact-primary" href={`${EMAIL_URL}?subject=Let's%20build%20something`}>Start a conversation <span aria-hidden="true">↗</span></a><a class="text-link" href={`${EMAIL_URL}?subject=An%20engineering%20role%20for%20Leo`}>Talk about a role ↗</a></section>
    <a class="tile grabkit product" href={grabkit.url} target="_blank" rel="noopener noreferrer"><div class="tile-label"><span>Open-source TypeScript</span><span aria-hidden="true">↗</span></div><GrabkitPreview /><h2>grabkit</h2><p>Make the request.<br />Get on with it.</p></a>
    <a class="tile planria product" href={planria.url} target="_blank" rel="noopener noreferrer"><div class="tile-label"><span>Shared money for couples</span><span>{projectStatusLabel[planria.status]} ↗</span></div><div class="money-art" aria-hidden="true"><span>Yours. Mine.</span><strong>Ours.</strong><div><i>£</i><i>£</i></div></div><h2>plan/ria</h2><p>Money. A little more together.</p></a>
    <a class="tile photo photo-leaves" href={instagram} target="_blank" rel="noopener noreferrer" aria-label="View Leonardo's street lamp photograph on Instagram"><img src="/images/photography/madrid-architecture.jpg" alt="A Madrid street lamp framed by green leaves" width="1800" height="1200" loading="lazy"/><span class="photo-credit">Look up <span aria-hidden="true">↗</span></span></a>
    <section class="tile writing" aria-labelledby="writing-title"><div class="writing-head"><h2 id="writing-title">Thinking <em>out loud.</em></h2><a class="text-link" href="/blog">All writing ↗</a></div><div class="writing-list">{writing.map(entry => <a href={entry.href} {...(entry.kind === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><div><span>{entry.publisher ?? 'On the blog'}</span><h3>{entry.title}</h3></div><span aria-hidden="true">↗</span></a>)}</div></section>
    <a class="tile photo photo-detail" href={instagram} target="_blank" rel="noopener noreferrer" aria-label="View Leonardo's yellow sign photograph on Instagram"><img src="/images/photography/madrid-street.jpg" alt="A yellow sign half hidden by plants beside a bench in Madrid" width="1200" height="800" loading="lazy"/><span class="photo-credit">@don.leo.lemos <span aria-hidden="true">↗</span></span></a>
    <section class="projects-tile" aria-label="Selected work">
      <div class="projects-heading"><span>Selected work</span></div>
      <div class="projects-subtiles">
        <a class="project-card konijn" href="https://konijn.co" target="_blank" rel="noopener noreferrer">
          <div class="project-rim">
            <div class="project-face">
              <div class="tile-label"><span>Independent headwear</span><span aria-hidden="true">↗</span></div>
              <h2><img src="/images/konijn-logo.svg" alt="konijn" width="3475" height="1210" loading="lazy" /></h2>
              <p>Chronically online.<br />Finally outside.</p>
            </div>
          </div>
        </a>
        <a class="project-card galicia" href="https://galicia.mrlemoos.dev" target="_blank" rel="noopener noreferrer">
          <div class="project-rim">
            <div class="project-face">
              <div class="tile-label"><span>A skill set for coding agents</span><span aria-hidden="true">↗</span></div>
              <h2>galicia<span aria-hidden="true">.</span></h2>
              <p>Keep the judgement.<br /><em>Lose the overhead.</em></p>
              <div class="galicia-skills" aria-label="Five focused skills"><span>/terse</span><span>/rubberduck</span><span>/spec</span><span>/breakdown</span><span>/find-rc</span></div>
            </div>
          </div>
        </a>
        <a class="project-card ludus" href="https://ludus.mrlemoos.dev" target="_blank" rel="noopener noreferrer">
          <div class="project-rim">
            <div class="project-face">
              <div class="tile-label"><span>A place to play</span><span aria-hidden="true">↗</span></div>
              <h2>ludus<span aria-hidden="true">.</span></h2>
              <p>Make room for<br /><em>play.</em></p>
              <LudusBoard client:visible />
            </div>
          </div>
        </a>
      </div>
    </section>
  </div>
  <div class="launch-end"><span>Care in the details. Curiosity everywhere.</span><a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">See my code ↗</a><a href={EMAIL_URL}>me@mrlemoos.dev ↗</a></div>
</div>
<style>
.projects-heading{grid-column:1/-1;font-size:clamp(32px,4vw,48px);font-weight:400;letter-spacing:-.065em;margin:34px 0 -2px}.project-card{grid-column:span 4;min-height:355px;display:flex;flex-direction:column;align-items:flex-start}.tile.galicia{background:#e9eef4;color:#253a51}.galicia .tile-label{width:100%;color:#53677d}.galicia h2,.ludus h2{font-size:28px;font-weight:500;letter-spacing:-.06em;margin-top:28px}.galicia h2 span{color:#758fa9}.galicia>p,.ludus>p{font-size:clamp(28px,3vw,38px);line-height:1.12;letter-spacing:-.055em;margin:20px 0 28px}.galicia-skills{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.galicia-skills span{font:10px var(--font-geist-mono);padding:8px 12px;border:1px solid #253a5126;border-radius:999px}.ludus{background:#e8e6ff;color:#302d57}.ludus .tile-label{color:#625f8d}.ludus h2 span{color:#8984bd}.ludus-board{display:grid;grid-template-columns:repeat(8,1fr);width:190px;aspect-ratio:1;gap:0;margin:auto 20px 6px 0;transform:perspective(500px) rotateX(58deg) rotateZ(-43deg);transform-style:preserve-3d;box-shadow:12px 16px 0 #514d7f,20px 27px 22px #302d5740;transition:transform .5s var(--ease-smooth-out)}.ludus:hover .ludus-board{transform:perspective(500px) rotateX(58deg) rotateZ(-38deg) translateY(-7px)}.ludus-square{display:grid;place-items:center;background:#d7d4f6;aspect-ratio:1}.ludus-square.dark{background:#665f9f}.ludus-piece{position:relative;display:block;width:15px;height:19px;border-radius:45% 45% 28% 28%;background:linear-gradient(90deg,#f8f7ff,#aaa7ce 42%,#f8f7ff 70%);box-shadow:0 4px 0 #817daf,0 7px 5px #211f3c80;transform:rotateZ(43deg) rotateX(-58deg) translateZ(13px);transform-style:preserve-3d}.ludus-piece:after{content:"";position:absolute;width:20px;height:5px;border-radius:50%;left:50%;bottom:-3px;translate:-50% 0;background:inherit;box-shadow:0 3px 0 #817daf}.ludus-piece.dark{background:linear-gradient(90deg,#4a456f,#17152b 45%,#5b5684 75%);box-shadow:0 4px 0 #100f20,0 7px 5px #211f3c80}.ludus-piece.dark:after{box-shadow:0 3px 0 #100f20}.ludus-piece-head{position:absolute;width:9px;height:9px;border-radius:50%;left:50%;top:-6px;translate:-50% 0;background:inherit}.ludus-piece.rook{border-radius:18% 18% 28% 28%;height:18px}.ludus-piece.rook .ludus-piece-head{width:15px;height:7px;border-radius:1px;top:-5px;background:linear-gradient(90deg,#f8f7ff,#aaa7ce 42%,#f8f7ff 70%)}.ludus-piece.rook.dark .ludus-piece-head{background:linear-gradient(90deg,#4a456f,#17152b 45%,#5b5684 75%)}.ludus-piece.bishop{height:21px;border-radius:35% 35% 25% 25%}.ludus-piece.bishop .ludus-piece-head{height:11px;border-radius:50% 50% 45% 45%;top:-8px}.ludus-piece.knight{height:21px;border-radius:55% 22% 28% 28%;rotate:-10deg}.ludus-piece.knight .ludus-piece-head{width:13px;height:13px;border-radius:55% 40% 45% 30%;top:-7px;left:62%}.ludus-piece.king{height:23px;border-radius:28% 28% 25% 25%}.ludus-piece.king .ludus-piece-head{width:3px;height:13px;border-radius:0;top:-11px;background:inherit;box-shadow:0 5px 0 -1px currentColor}
.bento{position:relative}
.launch{--ink:#232629;--canvas:#f0f1f3;--surface:#fafbfc;--grey:#6a6e74;--line:#e0e3e7;background:var(--canvas);color:var(--ink);padding:0 4vw 32px;font-family:var(--font-geist-sans)}.launch a{text-decoration:none}.launch :is(a,button,[tabindex]):focus-visible{outline:3px solid #5e8bc4;outline-offset:5px}.skip{position:absolute;top:-100px}.skip:focus{top:12px;z-index:99;background:white;padding:12px}.launch-nav{max-width:1400px;margin:auto;height:90px;display:flex;align-items:center;justify-content:space-between}.wordmark{font-size:30px;letter-spacing:-2px;font-weight:500}.wordmark span{color:#838b94}.launch-nav nav{display:flex;gap:30px;font-size:12px;color:var(--grey)}.nav-contact{font-size:12px}.nav-contact span{margin-left:18px}.launch-nav a:hover{color:#338059}.bento{max-width:1400px;margin:auto;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:18px}.tile{min-width:0;border-radius:24px;position:relative;overflow:hidden;background:var(--surface);padding:30px;border:1px solid #fff8;box-shadow:0 2px 3px #20262d03;transition:transform .3s var(--ease-smooth-out),box-shadow .3s}.tile:is(a):hover{transform:translateY(-4px);box-shadow:0 12px 32px #20262d0b}.tile-label{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.02em;color:var(--grey)}.tiny-mark{font-size:18px}h1{font-size:clamp(58px,6vw,86px);font-weight:500;line-height:1.02;letter-spacing:-.075em;margin:28px 0 22px}em{font-family:var(--font-instrument-serif);font-weight:400;letter-spacing:-.035em}.bio{grid-column:span 5;grid-row:span 2;display:flex;flex-direction:column;min-height:454px}.bio>p{font-size:16px;line-height:1.6;color:var(--grey)}.text-link{font-size:12px;display:inline-block}.text-link:hover{text-decoration:underline;text-underline-offset:5px}.bio>.text-link{margin:23px 0 30px}.bio>.text-link span{margin-left:16px}.bio-footer{margin-top:auto;display:flex;flex-wrap:wrap;gap:7px 16px;font-size:9px;color:var(--grey)}.bio-footer a{color:var(--ink)}.location{grid-column:span 3;min-height:270px;background:radial-gradient(ellipse at 75% 25%,#fffaf0,#eae7df 75%);color:#292722;padding:23px;display:flex;align-items:end;overflow:visible;isolation:isolate;z-index:2}.location-art{position:absolute;inset:0;pointer-events:none}.location-coordinate{position:absolute;top:17px;left:20px;font-family:var(--font-geist-mono);font-size:7px;letter-spacing:.05em;color:#8a8275;writing-mode:vertical-rl}.gran-via{position:absolute;width:95%;max-width:none;height:auto;right:-5%;top:-55px;filter:drop-shadow(0 15px 9px #46362620);transform:rotate(-6deg);transform-origin:50% 75%;transition:transform .7s var(--ease-smooth-out),filter .7s}.gran-via-shadow{position:absolute;top:58%;left:28%;width:65%;height:21%;border-radius:50%;background:#67503b24;filter:blur(13px);transform:rotate(-18deg)}.location:hover .gran-via{transform:translateY(-7px) rotate(-3deg);filter:drop-shadow(0 22px 12px #4636262b)}.location-copy{position:relative;z-index:1}.location-copy h2{font-size:25px;font-weight:500;letter-spacing:-.05em}.location-copy h2 span{display:inline-block;font-size:9px;letter-spacing:0;color:#625d55;margin-left:12px;vertical-align:middle}.location-copy p{font-size:10px;color:#625d55;margin-top:4px}.photo{padding:0;border:0;display:block}.photo img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;transition:transform .6s var(--ease-smooth-out)}.photo:hover img{transform:scale(1.035)}.photo:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#0e1f2490,transparent 40%);pointer-events:none}.photo-street{grid-column:span 4;grid-row:span 2;min-height:454px}.photo-street img{object-position:55% center}.photo-credit{position:absolute;bottom:24px;left:25px;right:25px;color:white;z-index:1;display:flex;justify-content:space-between;font-size:11px}.impact{grid-column:span 3;min-height:218px;padding:24px;background:#dfe6ec}.impact .tile-label{color:#626f7c}.impact strong{display:block;font-size:45px;font-weight:400;letter-spacing:-.075em;margin:18px 0 12px;white-space:nowrap}.impact strong>span{font-size:24px;padding:0 6px;color:#8393a3}.impact small{font-size:20px;letter-spacing:-.02em}.impact>p:last-child{font-size:10px;line-height:1.65;color:#596977}.product h2{font-size:32px;letter-spacing:-.06em;font-weight:500;line-height:1.15}.product>p{font-size:12px;margin-top:7px;color:var(--grey)}.madrid,.termi{grid-column:span 6;min-height:430px}.madrid{background:#ece8e1;color:#292722;display:flex;flex-direction:column}.madrid .tile-label{color:#787164}.madrid h2,.termi h2{margin-top:24px}.madrid>p{color:#787164}.madrid-screen{margin:32px 0 16px;position:relative;height:220px}.madrid-screen img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 13px 16px #3b2c221c);transition:transform .5s var(--ease-smooth-out)}.madrid:hover .madrid-screen img{transform:translateY(-4px) rotate(-1deg)}.product-footer{margin-top:auto;display:flex;justify-content:space-between;gap:12px;font-size:9px;color:#787164}.termi{background:#20252d;color:#f2f5f7;display:flex;flex-direction:column}.termi .tile-label,.termi>p,.termi .product-footer{color:#a9b1bc}@font-face{font-family:"Termi Meslo";src:url('/termi/meslo-regular.woff2') format('woff2');font-weight:400;font-display:swap}
.terminal-scene{position:relative;isolation:isolate;margin:24px -3px 24px;min-height:240px;display:grid;align-items:center}
.terminal-scene:before,.terminal-scene:after{content:'';position:absolute;z-index:-1;pointer-events:none;border-radius:50%;filter:blur(24px)}
.terminal-scene:before{width:65%;height:78%;left:-4%;top:0;background:radial-gradient(ellipse,#9c8fecb3,#688ec373 55%,transparent 75%)}
.terminal-scene:after{width:58%;height:65%;right:-4%;bottom:0;background:radial-gradient(ellipse,#cc9fa382,#7974c35e 50%,transparent 75%)}
.terminal-window{position:relative;background:linear-gradient(135deg,#20273780,#161b298c);backdrop-filter:blur(24px) saturate(140%);-webkit-backdrop-filter:blur(24px) saturate(140%);border:1px solid #ffffff2e;border-radius:12px;box-shadow:0 24px 38px -15px #0007,inset 0 1px 0 #ffffff18;color:#f0edf7;font-family:"Termi Meslo",var(--font-geist-mono);transform:rotate(-2deg);overflow:hidden;transition:transform .5s var(--ease-smooth-out)}
.termi:hover .terminal-window{transform:rotate(0deg) translateY(-3px)}
.terminal-window:after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(145deg,#ffffff08,transparent 45%)}
.terminal-lights{position:absolute;left:14px;top:11px;display:flex;gap:6px;opacity:0;transition:opacity .2s}
.terminal-lights i{width:7px;height:7px;border-radius:50%;background:#ff5f57}
.terminal-lights i:nth-child(2){background:#febc2e}.terminal-lights i:nth-child(3){background:#28c840}
.termi:hover .terminal-lights,.termi:focus-visible .terminal-lights{opacity:1}
.terminal-body{padding:31px 20px 19px;font-size:10px;line-height:1.7}
.terminal-prompt{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:9px}
.terminal-prompt>span{color:#26222e;background:#edabc0;padding:1px 9px;border-radius:5px 0 0 5px;margin-right:-7px}
.terminal-prompt>span+span{background:#efc4a8;border-radius:0 5px 5px 0;margin-right:4px}
.terminal-prompt>b{font-weight:400;color:#bcd8ba}
.terminal-agent{display:flex;align-items:center;gap:17px;margin:25px 0}
.terminal-agent pre{color:#e8a88c;font:400 9px/1.05 "Termi Meslo",monospace;white-space:pre;margin:0}
.terminal-agent strong{font-size:17px;letter-spacing:-.04em;font-weight:400;display:block}
.terminal-agent>div>span{font-size:8px;color:#c4bfd1;display:block;margin-top:3px}
.terminal-request{border-top:1px solid #ffffff1a;border-bottom:1px solid #ffffff1a;padding:9px 0;display:flex;align-items:center;gap:8px;white-space:nowrap;font-size:9px}
.terminal-request>span{color:#c1cfef}.terminal-request i{display:inline-block;width:5px;height:11px;background:#e5e2ef;margin-left:2px}
.terminal-thinking{font-size:8px;color:#edb19b;margin-top:13px}.terminal-thinking>span{color:#b4aebe;font-size:7px;margin-left:9px}
.terminal-tabs{display:flex;align-items:stretch;gap:0;border-top:1px solid #ffffff12;background:#16192329;font-family:var(--font-geist-sans);font-size:9px;color:#c1bccf;white-space:nowrap}
.terminal-tabs>span{display:flex;align-items:center;gap:7px;padding:7px 11px}
.terminal-tabs .terminal-tab-active{background:#e5e2ed;color:#272331;padding-left:17px}
