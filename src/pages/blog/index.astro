---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPageMeta } from "@/lib/seo";
import Breadcrumb from "@/components/Breadcrumb.astro";
import WritingList from "@/components/WritingList.astro";
import { textLink } from "@/lib/css";
import { filterLivePosts } from "@/lib/admin/public-filter";
import { FEED_PATH } from "@/lib/rss";

const site = Astro.site!;
const siteOrigin = site.origin;
const blogUrl = new URL("/blog", site).href;

const posts = filterLivePosts(await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const meta = buildPageMeta(site, {
  title: "Blog | Leonardo Lemos",
  description:
    "Articles on frontend engineering, design systems and AI, Tailwind CSS, analytics, and shipping resilient web software—by Leonardo Lemos.",
  keywords: [
    "frontend blog",
    "design systems",
    "Tailwind CSS",
    "Astro",
    "software engineering",
    "Leonardo Lemos",
  ],
  structuredData: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": `${blogUrl}#webpage`,
        url: blogUrl,
        name: "Blog | Leonardo Lemos",
        description:
          "Articles on frontend engineering, design systems, Tailwind CSS, analytics, and resilient web software.",
        isPartOf: { "@id": `${siteOrigin}/#website` },
        breadcrumb: { "@id": `${blogUrl}#breadcrumb` },
      },
      {
        "@type": "BreadcrumbList",
        "@id": `${blogUrl}#breadcrumb`,
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteOrigin,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: blogUrl,
          },
        ],
      },
      {
        "@type": "Blog",
        "@id": `${blogUrl}#blog`,
        url: blogUrl,
        name: "Leonardo Lemos — blog",
        description:
          "Frontend engineering, design systems, and practical notes on building for the web.",
        publisher: { "@id": `${siteOrigin}/#person` },
        blogPost: posts.map((p) => ({
          "@type": "BlogPosting",
          headline: p.data.title,
          url: new URL(`/blog/${p.id}`, site).href,
        })),
      },
      {
        "@type": "ItemList",
        "@id": `${blogUrl}#itemlist`,
        numberOfItems: posts.length,
        itemListElement: posts.map((p, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: p.data.title,
          url: new URL(`/blog/${p.id}`, site).href,
        })),
      },
    ],
  },
});
---

<BaseLayout {...meta}>
  <div class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <Breadcrumb
      items={[{ label: "Home", href: "/" }, { label: "Blog" }]}
    />
    <h1 class="mb-3 font-heading text-4xl tracking-tight text-foreground md:text-5xl">
      Blog posts
    </h1>
    <p class="mb-10 text-muted-foreground">
      Reading by topic? <a href="/blog/tags" class={textLink}>Browse every tag</a>.
      Prefer a reader? <a href={FEED_PATH} class={textLink}>Subscribe by RSS</a>.
    </p>
    <WritingList
      size="lead"
      titleTag="h2"
      items={posts.map(({ id, data: { title, date, description } }) => ({
        href: `/blog/${id}`,
        title,
        date,
        description,
      }))}
    />
  </div>
</BaseLayout>
