---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { buildPageMeta, SITE_BRAND_NAME } from "@/lib/seo";
import { cn, sectionEyebrow, tagChip, tagChipRow, textLink } from "@/lib/css";
import { groupPostsByTag } from "@/lib/tags";

const site = Astro.site!;
const siteOrigin = site.origin;
const blogUrl = new URL("/blog", site).href;
const pageUrl = new URL("/blog/tags", site).href;

const groups = groupPostsByTag(await getCollection("blog"));

const description = `Every tag on the blog — ${groups.length} topics spanning frontend engineering, design systems, AI-assisted development and the modern web.`;

const meta = buildPageMeta(site, {
  title: `Blog tags | ${SITE_BRAND_NAME}`,
  description,
  keywords: [
    "blog tags",
    "topics",
    "frontend engineering",
    "design systems",
    SITE_BRAND_NAME,
  ],
  structuredData: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": `${pageUrl}#webpage`,
        url: pageUrl,
        name: `Blog tags | ${SITE_BRAND_NAME}`,
        description,
        isPartOf: { "@id": `${siteOrigin}/#website` },
        breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      },
      {
        "@type": "BreadcrumbList",
        "@id": `${pageUrl}#breadcrumb`,
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: siteOrigin },
          { "@type": "ListItem", position: 2, name: "Blog", item: blogUrl },
          { "@type": "ListItem", position: 3, name: "Tags", item: pageUrl },
        ],
      },
      {
        "@type": "ItemList",
        "@id": `${pageUrl}#itemlist`,
        numberOfItems: groups.length,
        itemListElement: groups.map((group, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: group.label,
          url: new URL(`/blog/tags/${group.slug}`, site).href,
        })),
      },
    ],
  },
});

const postWord = (count: number) => (count === 1 ? "post" : "posts");
---

<BaseLayout {...meta}>
  <div class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog" },
        { label: "Tags" },
      ]}
    />
    <span class={cn(sectionEyebrow, "block")}>Index</span>
    <h1
      class="mb-3 mt-2 font-heading text-4xl tracking-tight text-foreground md:text-5xl"
    >
      Blog tags
    </h1>
    <p class="mb-10 max-w-prose text-pretty text-muted-foreground">
      {groups.length} topics across the blog. Pick one and read the lot.
    </p>
    {/* Chips, not a card grid: nine tags are a vocabulary, not nine destinations. */}
    <ul class={cn(tagChipRow, "m-0 list-none p-0")}>
      {
        groups.map((group, index) => (
          <li class="flex">
            <a
              href={`/blog/tags/${group.slug}`}
              class={cn(tagChip, "reveal")}
              style={`--reveal-index: ${Math.min(index, 8)}`}
              rel="tag"
            >
              {group.label}
              <span class="tag-chip-count">
                {group.posts.length}
                <span class="sr-only"> {postWord(group.posts.length)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-14 flex flex-wrap items-center gap-x-6 border-t border-border pt-8">
      <a href="/blog" class={cn(textLink, "inline-flex min-h-12 items-center text-sm font-medium")}>
        All posts on the blog →
      </a>
    </div>
  </div>
</BaseLayout>
