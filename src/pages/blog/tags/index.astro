---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { buildPageMeta, SITE_BRAND_NAME } from "@/lib/seo";
import { cn, interactivePress, materialThin, textLink } from "@/lib/css";
import { groupPostsByTag } from "@/lib/tags";

const site = Astro.site!;
const siteOrigin = site.origin;
const blogUrl = new URL("/blog", site).href;
const pageUrl = new URL("/blog/tags", site).href;

const groups = groupPostsByTag(await getCollection("blog"));

const description = `Every tag on the blog — ${groups.length} topics spanning frontend engineering, design systems, AI-assisted development and the modern web.`;

const meta = buildPageMeta(site, {
  title: `Blog tags | ${SITE_BRAND_NAME}`,
  description,
  keywords: [
    "blog tags",
    "topics",
    "frontend engineering",
    "design systems",
    SITE_BRAND_NAME,
  ],
  structuredData: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": `${pageUrl}#webpage`,
        url: pageUrl,
        name: `Blog tags | ${SITE_BRAND_NAME}`,
        description,
        isPartOf: { "@id": `${siteOrigin}/#website` },
        breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
      },
      {
        "@type": "BreadcrumbList",
        "@id": `${pageUrl}#breadcrumb`,
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: siteOrigin },
          { "@type": "ListItem", position: 2, name: "Blog", item: blogUrl },
          { "@type": "ListItem", position: 3, name: "Tags", item: pageUrl },
        ],
      },
      {
        "@type": "ItemList",
        "@id": `${pageUrl}#itemlist`,
        numberOfItems: groups.length,
        itemListElement: groups.map((group, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: group.label,
          url: new URL(`/blog/tags/${group.slug}`, site).href,
        })),
      },
    ],
  },
});

const tagCard = cn(
  materialThin,
  interactivePress,
  "group flex items-baseline justify-between gap-3 rounded-xl px-4 py-3 text-inherit no-underline",
  "transition-colors duration-150 ease-out",
  "hover:bg-[color-mix(in_oklab,var(--card)_55%,transparent)]",
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
);
---

<BaseLayout {...meta}>
  <div class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog" },
        { label: "Tags" },
      ]}
    />
    <h1
      class="mb-3 font-heading text-4xl tracking-tight text-foreground md:text-5xl"
    >
      Blog tags
    </h1>
    <p class="mb-10 text-muted-foreground">
      {groups.length} topics across the blog. Pick one and read the lot.
    </p>
    <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2">
      {
        groups.map((group) => (
          <li>
            <a href={`/blog/tags/${group.slug}`} class={tagCard}>
              <span class="font-medium text-foreground transition-colors duration-150">
                {group.label}
              </span>
              <span class="shrink-0 font-mono text-xs text-muted-foreground">
                {group.posts.length}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-12 border-t border-border pt-8">
      <a href="/blog" class={textLink}>All posts on the blog</a>
    </div>
  </div>
</BaseLayout>
