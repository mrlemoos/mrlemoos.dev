---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { buildPageMeta, SITE_BRAND_NAME } from "@/lib/seo";
import { formatDate } from "@/lib/date";
import { blogCardArticle, blogCardTitle, cn, textLink } from "@/lib/css";
import { groupPostsByTag } from "@/lib/tags";

export async function getStaticPaths() {
  const groups = groupPostsByTag(await getCollection("blog"));

  return groups.map((group) => ({
    params: { tag: group.slug },
    props: {
      label: group.label,
      tags: group.tags,
      posts: group.posts.map((post) => ({
        id: post.id,
        title: post.data.title,
        description: post.data.description,
        date: post.data.date,
      })),
    },
  }));
}

const { tag } = Astro.params;
const { label, tags, posts } = Astro.props;

const site = Astro.site!;
const siteOrigin = site.origin;
const blogUrl = new URL("/blog", site).href;
const tagsUrl = new URL("/blog/tags", site).href;
const pageUrl = new URL(`/blog/tags/${tag}`, site).href;

const postCount = posts.length;
const countLabel = postCount === 1 ? "1 post" : `${postCount} posts`;
const description = `${countLabel} tagged “${label}” — writing on frontend engineering, design systems and shipping resilient web software by ${SITE_BRAND_NAME}.`;

const meta = buildPageMeta(site, {
  title: `Posts tagged “${label}” | ${SITE_BRAND_NAME}`,
  description,
  keywords: [...new Set([...tags, "blog", SITE_BRAND_NAME])],
  structuredData: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": `${pageUrl}#webpage`,
        url: pageUrl,
        name: `Posts tagged “${label}”`,
        description,
        isPartOf: { "@id": `${siteOrigin}/#website` },
        breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
        about: { "@type": "Thing", name: label },
      },
      {
        "@type": "BreadcrumbList",
        "@id": `${pageUrl}#breadcrumb`,
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: siteOrigin },
          { "@type": "ListItem", position: 2, name: "Blog", item: blogUrl },
          { "@type": "ListItem", position: 3, name: "Tags", item: tagsUrl },
          { "@type": "ListItem", position: 4, name: label, item: pageUrl },
        ],
      },
      {
        "@type": "ItemList",
        "@id": `${pageUrl}#itemlist`,
        numberOfItems: postCount,
        itemListElement: posts.map((post, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: post.title,
          url: new URL(`/blog/${post.id}`, site).href,
        })),
      },
    ],
  },
});
---

<BaseLayout {...meta}>
  <div class="mx-auto max-w-4xl px-4 py-8 md:py-12">
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog" },
        { label: "Tags", href: "/blog/tags" },
        { label },
      ]}
    />
    <h1
      class="mb-3 font-heading text-4xl tracking-tight text-foreground md:text-5xl"
    >
      Posts tagged “{label}”
    </h1>
    <p class="mb-10 text-muted-foreground">
      {countLabel} under this tag.
      {
        tags.length > 1 && (
          <span>
            Also written as {tags.filter((t) => t !== label).join(", ")}.
          </span>
        )
      }
    </p>
    <div class="flex flex-col gap-5">
      {
        posts.map(({ id, title, date, description: postDescription }) => (
          <a
            href={`/blog/${id}`}
            class={cn(
              blogCardArticle,
              "block text-left text-inherit no-underline",
              "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            )}
          >
            <h2 class={cn(blogCardTitle, "mb-2 text-2xl font-normal md:text-3xl")}>
              {title}
            </h2>
            <p class="mb-2 text-sm text-muted-foreground">{formatDate(date)}</p>
            <p class="text-muted-foreground">{postDescription}</p>
          </a>
        ))
      }
    </div>
    <div class="mt-12 flex flex-col gap-4 border-t border-border pt-8">
      <a href="/blog/tags" class={textLink}>Browse every tag</a>
      <a href="/blog" class={textLink}>All posts on the blog</a>
    </div>
  </div>
</BaseLayout>
