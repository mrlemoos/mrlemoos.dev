---
export const prerender = true;
import '@fontsource/geist-mono/latin-400.css';
const repo = 'https://github.com/mrlemoos/Act';
const features = [
 {id:'screenplay', tab:'Screenplay', title:'Stay with the scene.', text:'A native Fountain editor that gives your words room. Jump between scenes, adjust the page to your taste and export a screenplay PDF when it is time to share.', points:['Plain-text Fountain files', 'Scene outline and writing settings', 'Screenplay PDF export'], image:'screenplay'},
 {id:'board', tab:'Board', title:'Make room for the messy part.', text:'Put drafts, scene cards and loose thoughts on a canvas. Gather them into groups. Move the pieces around until the story starts to make sense.', points:['A pannable, zoomable project canvas', 'Linked drafts, scene cards and notes', 'Your layout never rewrites your script'], image:'board'},
 {id:'shots', tab:'Shot list', title:'See it before you shoot it.', text:'Plan coverage beside the scene. Build a shot list yourself, or ask a local model for a first pass and make it yours. Your screenplay stays untouched.', points:['Scene-by-scene shot planning', 'Optional offline AI on Apple Silicon', 'Separate shot-list files'], image:'shots'},
 {id:'characters', tab:'Characters', title:'Put a face to the name.', text:'Mark character introductions as you write. Extract physical details locally, refine a reference-sheet prompt and keep earlier image versions as the character develops.', points:['Character marks linked to action paragraphs', 'Local physical-detail extraction', 'Approved image requests through your connected agent'], image:'characters'},
];
const title = 'Act | Write the scene. Plan the film.';
const description = 'A native macOS app for screenwriters. Write in Fountain, organise your project on a board, plan shots and create character reference sheets.';
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<link rel="canonical" href="https://mrlemoos.dev/act" /><link rel="icon" href="/act/icon.png" />
<meta name="theme-color" content="#fafafa" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://mrlemoos.dev/act" /><meta property="og:image" content="https://mrlemoos.dev/act/screenplay.png" /><meta name="twitter:card" content="summary_large_image" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><a class="brand" href="/act" aria-label="Act home"><img src="/act/icon.png" width="36" height="36" alt="" />Act</a><nav aria-label="Main navigation"><a href="#workspaces">Overview</a><a href={`${repo}#readme`}>Documentation</a><a class="small-cta" href="#get-act">Get Act</a></nav></header>
<main id="main">
<section class="hero">
<div class="hero-copy">
  <img class="hero-icon" src="/act/icon.png" width="88" height="88" alt="Act app icon" />
  <p class="eyebrow">Act for Mac</p>
  <h1>Your screenplay.<br /><em>The whole picture.</em></h1>
  <p class="hero-description">Write the scene. Plan the shot. Meet the character.<br class="desktop-break" /> A native Mac app for the film you're making.</p>
  <div class="hero-actions"><a class="button" href="#get-act">Get Act for Mac</a><a class="secondary-link" href="#workspaces">Take a closer look <span aria-hidden="true">↓</span></a></div>
  <p class="compat">macOS 15 or later. Available to build from source.</p>
</div>
<div class="hero-stage"><div class="preview-heading"><div class="preview-controls" role="group" aria-label="Preview Act workspaces"><span class="selection" aria-hidden="true"></span>{features.map((f, i) => <button type="button" data-preview={f.image} data-alt={`Act ${f.tab} workspace`} aria-pressed={i === 0}>{f.tab}</button>)}</div></div><figure class="hero-window"><div class="window-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span>A new beginning.fountain</span><span>Act</span></div><img id="workspace-preview" src="/act/screenplay.png" width="1865" height="1312" alt="Act's Screenplay tab with formatted Fountain dialogue and a marked character introduction" fetchpriority="high" /></figure><div class="stage-caption"><p id="preview-caption">A proper screenplay page. Plain-text Fountain underneath.</p><a href="#screenplay" id="preview-link">Explore Screenplay <span aria-hidden="true">›</span></a></div><p class="preview-status" aria-live="polite">Screenplay workspace</p></div>
</section>
<div class="manifesto"><p>A screenplay you own.<br /><em>In a format that lasts.</em></p><div><p>Act works with plain-text Fountain. Your screenplay, shot lists and character library stay in separate files, so planning the film never overwrites the writing.</p><a href={`${repo}#readme`}>Read how Act works <span aria-hidden="true">↗</span></a></div></div>
<section id="workspaces" class="workspaces"><div class="section-top"><p class="eyebrow">A place for every part of the story</p><h2>From the first line<br /><em>to the next shot.</em></h2></div>
{features.map((f, i)=><article id={f.id} class:list={['feature', {reverse:i%2===1}]}><div class="feature-copy"><p class="eyebrow">{f.tab}</p><h3>{f.title}</h3><p>{f.text}</p><ul>{f.points.map(p=><li>{p}</li>)}</ul>{f.id==='characters' && <p class="fine">Image generation uses your connected external agent. You approve each request; provider charges may apply.</p>}</div><figure class={`feature-image ${f.id}`}><img src={`/act/${f.image}.png`} width="1865" height="1312" alt={`Act ${f.tab} workspace`} loading="lazy" /><figcaption>{f.tab} / Act for macOS</figcaption></figure></article>)}
</section>
<section class="review-section" aria-labelledby="review-title"><div><p class="eyebrow">AI, with your approval</p><h2 id="review-title">Bring your agent.<br /><em>Keep your voice.</em></h2><p>Work with an AI agent on your open screenplay, including unsaved writing. See what changed, compare before and after, and accept or reject each edit in a popup beside the page.</p><a class="text-link" href={`${repo}/blob/main/CLI/README.md`}>Explore the AI workflow <span aria-hidden="true">↗</span></a></div><div class="review-example"><div class="review-label">EDIT REVIEW <span>Illustrative example</span></div><p class="scene-heading">INT. TRAIN STATION · NIGHT</p><p class="before">She looks around nervously as she waits.</p><p class="after">Her eyes flick to the clock. Back to the door.</p><div class="review-caption"><span>Before / after</span><span>You choose what stays.</span></div></div></section>
<section class="local"><p class="eyebrow">Native by design</p><h2>Right at home.<br /><em>On your Mac.</em></h2><div class="local-details"><p>Write and organise locally. Optional shot suggestions and physical-detail extraction run on your Mac with configured models. Image generation only leaves the machine when you approve a request.</p><p>Made for macOS 15 or later.<br />Local AI requires additional model setup.<br />Interface available in seven locales.</p></div></section>
<section id="get-act" class="setup"><div><p class="eyebrow">Your next film starts here</p><h2>Make room for<br /><em>your next idea.</em></h2><p>Act is in active development. Build it from source with macOS 15 or later, Swift 6 and Bun. The built app needs neither Bun nor Node.</p><a class="button" href={`${repo}#run`}>Get build instructions <span aria-hidden="true">↗</span></a><p class="setup-note">Development build. Not a notarised distribution release.</p></div><div class="questions"><h3>Before you start</h3><details><summary>What happens to my screenplay?</summary><p>It stays a plain-text Fountain file on your Mac. Shot lists, character images and edit history live separately. Export a screenplay PDF when you want to share the page.</p></details><details><summary>Do I need AI to use Act?</summary><p>No. Write, navigate scenes, export PDFs and plan shots yourself. Local AI is optional and requires a separate runtime and model.</p></details><details><summary>Does anything leave my Mac?</summary><p>Writing and local inference run on your Mac. External image generation sends the prompt and references you approve to your configured provider. Agent connections use their own accounts and may incur charges.</p></details><details><summary>Can I review AI edits?</summary><p>Yes. Each proposed change has a before/after review with Accept and Reject. Reject safely reverts the applied edit. Changes also participate in native undo.</p></details></div></section>
<section class="closing" aria-label="Get Act"><img src="/act/icon.png" width="80" height="80" alt="Act app icon" /><h2>Made for your Mac.<br /><em>Ready for your story.</em></h2><a class="button" href={`${repo}#run`}>Build Act for your Mac <span aria-hidden="true">↗</span></a><p>Source, setup and build instructions.</p></section>
</main><footer><a href="/">Leonardo Lemos</a><span>Act for macOS</span><a href={repo}>GitHub ↗</a></footer>
</body></html>
<script>
  const preview = document.querySelector<HTMLImageElement>('#workspace-preview');
  const controls = [...document.querySelectorAll<HTMLButtonElement>('[data-preview]')];
  const group = document.querySelector<HTMLElement>('.preview-controls');
  const status = document.querySelector<HTMLElement>('.preview-status');
  const caption = document.querySelector<HTMLElement>('#preview-caption');
  const link = document.querySelector<HTMLAnchorElement>('#preview-link');
  const captions: Record<string, string> = {
    screenplay: 'A proper screenplay page. Plain-text Fountain underneath.',
    board: 'Your drafts, scenes and loose thoughts. Room to move them around.',
    shots: 'Find your coverage. Plan each shot beside the scene.',
    characters: 'Keep the faces and details of your cast together.',
  };
  let selection = 0;
  let pending = 0;
  let transition: Animation | undefined;
  const select = async (index: number) => {
    const button = controls[index];
    if (!preview || !button) return;
    selection = index;
    const request = ++pending;
    group?.style.setProperty('--selected', String(index));
    controls.forEach((control) => control.setAttribute('aria-pressed', String(control === button)));
    const workspace = button.dataset.preview ?? 'screenplay';
    const source = `/act/${workspace}.png`;
    const image = new Image();
    image.src = source;
    try { await image.decode(); } catch { return; }
    if (request !== pending) return;
    transition?.cancel();
    preview.src = source;
    preview.alt = button.dataset.alt ?? '';
    if (caption) caption.textContent = captions[workspace];
    if (link) {
      link.href = `#${workspace}`;
      link.textContent = `Explore ${button.textContent} ›`;
    }
    if (status) status.textContent = `${button.textContent} workspace`;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      transition = preview.animate([{ opacity: 0.5 }, { opacity: 1 }], { duration: 180, easing: 'ease-out' });
    }
  };
  controls.forEach((button, index) => {
    button.addEventListener('click', () => void select(index));
    button.addEventListener('keydown', (event) => {
      let next = selection;
      if (event.key === 'ArrowRight') next = (index + 1) % controls.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + controls.length) % controls.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = controls.length - 1;
      else return;
      event.preventDefault();
      controls[next].focus();
      void select(next);
    });
  });
</script>
<style>
  :root {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #1d1d1f;
    background: #fff;
    font-synthesis: none;
    font-optical-sizing: auto;
    --ink: #1d1d1f;
    --muted: #6e6e73;
    --blue: #0066cc;
    --paper: #f5f5f7;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 90px; }
  body { margin: 0; -webkit-font-smoothing: antialiased; }
  h1, h2, h3, p, figure { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #0071e3; outline-offset: 5px; }
  header {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between;
    min-height: 64px; padding: 0 max(6%, calc((100vw - 1080px) / 2));
    background: #ffffffd9; backdrop-filter: saturate(180%) blur(22px);
    border-bottom: 1px solid #00000012;
  }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 600; letter-spacing: -.6px; }
  .brand img { width: 29px; height: 29px; border-radius: 7px; }
  header nav { display: flex; align-items: center; gap: 28px; font-size: 12px; }
  header nav > a:not(.small-cta):hover { color: var(--blue); }
  .small-cta { background: #0071e3; color: #fff; padding: 8px 17px; border-radius: 25px; }
  .small-cta:hover, .button:hover { background: #0077ed; }
  .hero { background: #fafafa; overflow: hidden; }
  .hero-copy { text-align: center; max-width: 1000px; margin: auto; padding: 64px 24px 42px; }
  .hero-icon { border-radius: 20px; box-shadow: 0 8px 20px #0000000c; margin-bottom: 18px; }
  .eyebrow { font-size: 17px; line-height: 1.4; font-weight: 600; letter-spacing: -.2px; color: var(--muted); }
  .hero-copy .eyebrow { color: var(--ink); font-size: 21px; }
  h1 { font-size: clamp(52px, 6vw, 84px); font-weight: 650; letter-spacing: -.055em; line-height: 1.04; margin: 18px 0 24px; }
  em { color: var(--muted); font-style: normal; }
  .hero-description { font-size: clamp(18px, 2vw, 23px); line-height: 1.45; letter-spacing: -.45px; color: var(--muted); }
  .hero-actions { display: flex; gap: 26px; align-items: center; justify-content: center; margin-top: 29px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 20px; padding: 13px 24px; background: #0071e3; color: #fff; border-radius: 30px; font-size: 16px; line-height: 1.3; transition: background 160ms, transform 160ms; }
  .button:active, .small-cta:active { transform: scale(.97); }
  .secondary-link, .text-link, .manifesto a { color: var(--blue); font-size: 16px; }
  .secondary-link:hover, .text-link:hover, .manifesto a:hover { text-decoration: underline; }
  .secondary-link span { padding-left: 5px; }
  .compat { color: var(--muted); font-size: 12px; margin-top: 17px; }
  .hero-stage { position: relative; max-width: 1240px; padding: 0 60px 66px; margin: auto; }
  .preview-heading { display: flex; justify-content: center; margin: 0 0 28px; }
  .preview-controls { --selected: 0; position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; padding: 4px; background: #e9e9ed; border: 1px solid #00000005; border-radius: 30px; width: 460px; isolation: isolate; }
  .selection { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / 4); transform: translateX(calc(var(--selected) * 100%)); border-radius: 25px; background: #fff; box-shadow: 0 2px 6px #00000013, 0 0 1px #00000020; transition: transform 280ms cubic-bezier(.22, 1, .36, 1); z-index: -1; }
  .preview-controls button { appearance: none; border: 0; border-radius: 25px; background: transparent; color: #64646b; font: 500 13px/1.3 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; min-height: 40px; cursor: pointer; -webkit-tap-highlight-color: transparent; touch-action: manipulation; transition: color 140ms; }
  .preview-controls button[aria-pressed='true'] { color: var(--ink); }
  .preview-controls button:active { background: #00000006; }
  .hero-window { border-radius: 13px; overflow: hidden; background: #fff; border: 1px solid #00000016; box-shadow: 0 30px 65px -22px #00000030, 0 8px 18px -8px #00000012; }
  .window-bar { height: 34px; display: flex; align-items: center; justify-content: space-between; padding: 0 14px; background: #f3f3f3; color: #777; font-size: 10px; border-bottom: 1px solid #0000000a; }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: #ff5f57; border: 1px solid #0000000a; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .hero-window > img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; object-position: top; }
  .stage-caption { display: flex; align-items: center; justify-content: center; gap: 16px; padding-top: 23px; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .stage-caption a { color: var(--blue); white-space: nowrap; }
  .preview-status, .skip:not(:focus) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .skip:focus { position: fixed; top: 15px; left: 15px; background: white; padding: 12px; z-index: 20; }
  .manifesto { max-width: 1080px; margin: auto; padding: 110px 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 85px; align-items: center; }
  .manifesto > p { font-size: 39px; font-weight: 600; letter-spacing: -1.6px; line-height: 1.12; }
  .manifesto div p { font-size: 18px; line-height: 1.6; color: var(--muted); }
  .manifesto a { display: inline-block; margin-top: 20px; }
  h2 { font-size: clamp(38px, 4.5vw, 58px); font-weight: 650; line-height: 1.08; letter-spacing: -.045em; }
  .workspaces { background: var(--paper); padding: 90px 30px; }
  .section-top { max-width: 1080px; margin: 0 auto 55px; text-align: center; }
  .section-top h2 { margin-top: 16px; }
  .feature { max-width: 1080px; margin: 0 auto 28px; background: #fff; border-radius: 28px; overflow: hidden; padding: 55px 0 55px 48px; display: grid; grid-template-columns: .85fr 1.3fr; gap: 45px; align-items: center; scroll-margin-top: 85px; }
  .feature:last-child { margin-bottom: 0; }
  .feature h3 { font-size: clamp(30px, 3.2vw, 43px); font-weight: 600; line-height: 1.08; letter-spacing: -.045em; margin: 12px 0 20px; }
  .feature .eyebrow { font-size: 13px; color: var(--blue); }
  .feature-copy > p:not(.eyebrow) { color: var(--muted); font-size: 15px; line-height: 1.65; }
  ul { padding: 0; list-style: none; margin: 24px 0 0; }
  li { font-size: 12px; line-height: 1.5; padding: 6px 0; color: #515154; }
  li::before { content: '✓'; margin-right: 9px; color: #86868b; }
  .feature-copy > p.fine { font-size: 11px; margin-top: 18px; }
  .feature-image { min-width: 0; align-self: center; }
  .feature-image img { display: block; width: 116%; height: auto; border: 1px solid #00000010; border-radius: 10px; box-shadow: 0 12px 30px #00000012; }
  .feature-image figcaption { font-size: 10px; margin-top: 16px; color: var(--muted); }
  .review-section { max-width: 1080px; padding: 110px 30px; margin: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 65px; align-items: center; }
  .review-section h2 { margin: 18px 0 24px; }
  .review-section > div > p:not(.eyebrow) { font-size: 17px; line-height: 1.6; color: var(--muted); }
  .text-link { display: inline-block; margin-top: 24px; }
  .review-example { padding: 28px; background: #fff; border-radius: 18px; border: 1px solid #0000000e; box-shadow: 0 20px 60px #0000000d, 0 3px 10px #00000006; }
  .review-label { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 20px; border-bottom: 1px solid #eee; color: var(--muted); font-size: 10px; }
  .review-label span { font-size: 9px; }
  .scene-heading { font: 11px 'Geist Mono', monospace; margin: 28px 0 22px; }
  .before, .after { font: 12px/1.9 'Geist Mono', monospace; padding: 15px; border-radius: 7px; }
  .before { background: #fcf0f0; color: #925455; text-decoration: line-through; margin-bottom: 10px; }
  .after { background: #edf7ee; color: #3d6944; }
  .review-caption { display: flex; justify-content: space-between; gap: 10px; margin-top: 22px; font-size: 10px; color: var(--muted); }
  .local { background: #1d1d1f; color: #f5f5f7; padding: 95px max(7%, calc((100vw - 1020px) / 2)); }
  .local .eyebrow { color: #a1a1a6; }
  .local h2 { margin: 18px 0 40px; }
  .local em { color: #a1a1a6; }
  .local-details { display: grid; grid-template-columns: 1.2fr 1fr; gap: 100px; }
  .local-details p { color: #b9b9be; font-size: 17px; line-height: 1.65; }
  .local-details p + p { font-size: 13px; line-height: 1.9; }
  .setup { max-width: 1080px; margin: auto; padding: 110px 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  .setup h2 { margin: 18px 0 24px; }
  .setup > div > p:not(.eyebrow) { color: var(--muted); font-size: 16px; line-height: 1.65; }
  .setup .button { margin-top: 27px; }
  .setup > div > p.setup-note { font-size: 11px; margin-top: 16px; }
  .questions { padding-top: 8px; }
  .questions h3 { font-size: 25px; letter-spacing: -.7px; margin-bottom: 24px; font-weight: 600; }
  .questions details { border-top: 1px solid #d2d2d7; padding: 22px 0; }
  .questions details:last-child { border-bottom: 1px solid #d2d2d7; }
  .questions summary { font-size: 14px; font-weight: 500; cursor: pointer; line-height: 1.5; }
  .questions details p { font-size: 13px; line-height: 1.7; color: var(--muted); margin-top: 15px; }
  .closing { background: var(--paper); text-align: center; padding: 80px 24px; }
  .closing img { width: 64px; height: 64px; border-radius: 15px; margin-bottom: 24px; }
  .closing h2 { font-size: clamp(32px, 4vw, 46px); margin-bottom: 26px; }
  .closing > p { font-size: 11px; color: var(--muted); margin-top: 17px; }
  footer { background: var(--paper); display: flex; justify-content: space-between; gap: 20px; padding: 24px max(6%, calc((100vw - 1080px) / 2)); border-top: 1px solid #d2d2d7; font-size: 11px; color: var(--muted); }
  @media (max-width: 700px) {
    header { min-height: 58px; padding: 0 20px; }
    header nav { gap: 18px; }
    header nav > a:not(.small-cta) { display: none; }
    .hero-copy { padding: 40px 22px 32px; }
    .hero-icon { width: 68px; height: 68px; border-radius: 16px; }
    .hero-copy .eyebrow { font-size: 18px; }
    h1 { font-size: clamp(40px, 10vw, 56px); margin-top: 16px; letter-spacing: -.05em; }
    .hero-description { font-size: 18px; letter-spacing: -.3px; }
    .desktop-break { display: none; }
    .hero-actions { gap: 19px; flex-wrap: wrap; margin-top: 24px; }
    .button { font-size: 14px; padding: 13px 20px; }
    .secondary-link { font-size: 14px; }
    .compat { font-size: 10px; }
    .hero-stage { padding: 0 16px 42px; }
    .preview-heading { margin-bottom: 22px; }
    .preview-controls { width: 100%; max-width: 390px; }
    .preview-controls button { font-size: 11px; min-height: 40px; }
    .hero-window { border-radius: 9px; }
    .window-bar { height: 25px; font-size: 8px; padding: 0 9px; }
    .dots { gap: 4px; }
    .dots i { width: 6px; height: 6px; }
    .stage-caption { flex-direction: column; text-align: center; font-size: 12px; gap: 6px; padding: 20px 16px 0; }
    .manifesto, .review-section, .setup { grid-template-columns: 1fr; padding: 65px 25px; gap: 30px; }
    .manifesto > p { font-size: 33px; letter-spacing: -1.2px; }
    .manifesto div p { font-size: 16px; }
    .eyebrow { font-size: 14px; }
    .workspaces { padding: 60px 16px; }
    .section-top { margin-bottom: 35px; }
    h2 { font-size: 38px; }
    .feature { padding: 30px 26px 28px; grid-template-columns: 1fr; gap: 28px; border-radius: 22px; margin-bottom: 18px; }
    .feature h3 { font-size: 33px; }
    .feature-image img { width: 100%; border-radius: 6px; }
    .feature-image figcaption { font-size: 9px; }
    .review-example { padding: 22px; }
    .local { padding: 65px 25px; }
    .local-details { grid-template-columns: 1fr; gap: 25px; }
    .local-details p { font-size: 16px; }
    .questions { padding-top: 20px; }
    .closing { padding: 60px 22px; }
    footer { flex-wrap: wrap; padding: 24px; }
    footer > span { order: 3; width: 100%; }
  }
