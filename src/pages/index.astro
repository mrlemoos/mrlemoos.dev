---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Launch from "@/components/Launch.astro";
import { GITHUB_URL, LINKEDIN_URL, X_URL } from "@/lib/constants";
import {
  buildPageMeta,
  DEFAULT_DESCRIPTION,
  SITE_BRAND_NAME,
} from "@/lib/seo";

const site = Astro.site!;
const siteOrigin = site.origin;
const knowsAbout = [
  "Frontend engineering",
  "Software architecture",
  "Design systems",
  "TypeScript",
  "Tailwind CSS",
  "Astro",
  "Web accessibility",
  "Open-source software",
] as const;

const meta = buildPageMeta(site, {
  title: "Leonardo Lemos | Good software. An eye for more.",
  description: "Madrid-based frontend engineer. Product interfaces, design systems and independent software, with a photographer's eye. Explore my work and start a conversation.",
  structuredData: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${siteOrigin}/#website`,
        url: siteOrigin,
        name: SITE_BRAND_NAME,
        description: DEFAULT_DESCRIPTION,
        publisher: { "@id": `${siteOrigin}/#person` },
        inLanguage: "en-GB",
      },
      {
        "@type": "Person",
        "@id": `${siteOrigin}/#person`,
        name: SITE_BRAND_NAME,
        url: siteOrigin,
        jobTitle: "Frontend engineer",
        knowsAbout: [...knowsAbout],
        sameAs: [GITHUB_URL, LINKEDIN_URL, X_URL],
      },
    ],
  },
});
---

<BaseLayout {...meta}>
  <Launch />
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.launch)) { scroll-behavior: smooth; }
  }
</style>
