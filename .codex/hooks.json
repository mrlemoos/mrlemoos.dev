{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.galicia/startup.ts\" codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
